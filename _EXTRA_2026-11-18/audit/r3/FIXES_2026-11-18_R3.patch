+def _cascade_sale_returns(sale, voided):
+    """Void (or restore) the material returns that belong to a sale.
+
+    A return has already put the goods back on the shelf and credited the
+    client.  Voiding the bill on its own restored the full delivered quantity a
+    second time: 200 kg delivered, 20 kg returned, bill voided -> 520 kg on hand
+    against a physical 500, plus a credit for goods the shop already has.  A
+    return therefore follows the sale it came from; only the ones reversed by
+    this cascade are marked, so a return voided by the operator stays void.
+    """
+    if sale is None or getattr(sale, 'id', None) is None:
+        return 0
+    returns = MaterialReturn.query.filter(MaterialReturn.source_sale_id == sale.id).all()
+    changed = 0
+    for ret in returns:
+        if voided:
+            if ret.is_void:
+                continue
+            _set_material_return_void_state(ret, True)
+            ret.voided_with_sale = True
+            changed += 1
+        else:
+            if not ret.is_void or not getattr(ret, 'voided_with_sale', False):
+                continue
+            _set_material_return_void_state(ret, False)
+            ret.voided_with_sale = False
+            changed += 1
+    return changed
