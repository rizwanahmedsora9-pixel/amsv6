+    Current Payables counts zero, and the operator cannot chase it.  The sale is
+    the authority for the name, so the master row is created (or an existing one
+    with that exact name is reused) at the moment the shortfall is recorded.
+    """
+    from models import Client
+
+    clean = (name or '').strip()
+    if not clean:
+        return None
+    existing = get_client_by_input(clean)
+    if existing is not None:
+        if getattr(existing, 'is_active', True) is False:
+            existing.is_active = True
+        return existing
+
+    digits = ''.join(ch for ch in clean.upper() if ch.isalnum())[:10] or 'WALKIN'
+    code = f"WC-{digits}"
+    suffix = 1
+    while Client.query.filter(func.lower(func.trim(Client.code)) == code.lower()).first() is not None:
+        suffix += 1
+        code = f"WC-{digits}-{suffix}"
+    # Use the client-ledger categories the database actually has; fall back to
+    # the caller's label when the table is empty.
+    category_name = category or 'General'
+    try:
+        from models import ClientCategory
+        wanted = (category or '').strip().lower()
+        rows = ClientCategory.query.all()
+        match = next((c.name for c in rows if (c.name or '').strip().lower() == wanted), None)
+        if match:
+            category_name = match
+        elif wanted != 'general':
+            match = next((c.name for c in rows if (c.name or '').strip().lower() == 'general'), None)
+            if match:
+                category_name = match
+    except Exception:
+        pass
+    client = Client(name=clean, code=code, category=category_name or 'General',
+                    is_active=True, phone='', address='', opening_balance=0)
+    db.session.add(client)
+    db.session.flush()
+    logging.getLogger(__name__).info('WALK_IN_CLIENT_CREATED name=%s code=%s', clean, code)
+    return client
+
+
